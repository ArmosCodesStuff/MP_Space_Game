config_version=5

[application]

config/name="Warships"
run/main_scene="res://MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

; Net owns the session and must exist before any world does.
Net="*res://scripts/Net.cs"
Music="*res://scripts/Music.cs"

[display]

window/vsync/vsync_mode=1
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/size/mode=3
window/size/borderless=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

; MSDF keeps glyphs sharp at any camera zoom; mipmaps do the same when zoomed out.
theme/default_font_multichannel_signed_distance_field=true
theme/default_font_generate_mipmaps=true
theme/default_font_subpixel_positioning=1
theme/default_font_antialiasing=1

[dotnet]

project/assembly_name="Warships"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
