<!-- THE LAUNCHER. A separate program on purpose: a running executable cannot overwrite itself, so
     something that is not the game has to replace the game, and a build that bricks itself can
     still be fixed by the thing that did not brick.

     IT IS NOT IN Warships.sln, DELIBERATELY. verify.ps1 runs `dotnet build` at the repo root, which
     takes the solution; adding this would put a WinForms project's warnings in the game's gate and
     its build time in every -Quick. Its compile gate is TreatWarningsAsErrors below, run by
     tools/pack.ps1.

     THE ONE LINE THAT MATTERS is the <Compile Include> at the bottom. Every decision this program
     makes lives in scripts/Builds.cs, which is compiled into the GAME as well, so typecheck.ps1
     sees it, xref.py sees it, and the smoke test can call it. Nothing in this project may grow a
     decision of its own; if something here needs an `if`, it belongs in Builds.cs or in pack.ps1.

     SIZE: ~65-70 MB published. "Tiny" is the code, not the file. Self-contained is the only setting
     a player can run without first installing the .NET 8 Desktop Runtime, and a prerequisite dialog
     would defeat the whole point. To trade that for ~250 KB and a prerequisite, set SelfContained
     to false: it is a property here, not a redesign. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- NOT "Warships": the launcher sits in the same folder as the game it starts, and the
         game's own exe is Warships.exe (export_presets.cfg, and BUILD.txt's launch= field).
         Two files of one name in one folder is a launcher that replaces itself. -->
    <AssemblyName>WarshipsLauncher</AssemblyName>
    <RootNamespace>Warships.Launcher</RootNamespace>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- SELF-CONTAINED AND WINFORMS IS 145 MB UNCOMPRESSED, which is 15x the game's own code part
         and the one file a player fetches by hand. Compressing the bundle is one property and
         costs a slower FIRST start only (the runtime is unpacked to a temp folder once, then
         cached). Trimming would be the real fix and WinForms cannot be trimmed. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WinForms does not support trimming; leaving it on produces a program that starts and then
         throws on the first control it reflects over. -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- THE SHARED MECHANISM. One copy, compiled into both programs, so the game's ladder proves
         the launcher's logic. -->
    <Compile Include="..\scripts\Builds.cs" Link="Builds.cs" />
  </ItemGroup>
</Project>
